<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Bakery Item"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText android:id="@+id/etItemName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Item Name" />
        <EditText android:id="@+id/etItemDesc" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Description" />
        <EditText android:id="@+id/etItemPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Price" android:inputType="numberDecimal" />
        <EditText android:id="@+id/etItemCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Category" />
        <EditText android:id="@+id/etItemStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Stock" android:inputType="number" />

    </LinearLayout>
</ScrollView>