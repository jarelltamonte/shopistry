<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".OrderList">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_revert"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Orders"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

        <ImageView
            android:id="@+id/btnFilter"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />

    </LinearLayout>

    <!-- Filter Tabs -->
    <HorizontalScrollView
        android:id="@+id/filterTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="All"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#403939"
                android:textColor="@android:color/white" />

            <Button
                android:id="@+id/btnPending"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Pending"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#424242" />

            <Button
                android:id="@+id/btnProcessing"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Processing"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#424242" />

            <Button
                android:id="@+id/btnShipped"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Shipped"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#424242" />

            <Button
                android:id="@+id/btnDelivered"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Delivered"
                android:textSize="14sp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#424242" />

            <Button
                android:id="@+id/btnCancelled"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Cancelled"
                android:textSize="14sp"
                android:backgroundTint="#E0E0E0"
                android:textColor="#424242" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Orders List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/filterTabs"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Order 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/orderCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Order Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvOrderId1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order #12345"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderStatus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Delivered"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:background="@android:color/holo_green_dark"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- Order Date -->
                    <TextView
                        android:id="@+id/tvOrderDate1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="January 15, 2026"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E0E0E0" />

                    <!-- Product Info -->
                    <TextView
                        android:id="@+id/tvOrderProduct1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iPhone 15 Pro Max"
                        android:textSize="14sp"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvOrderQuantity1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Quantity: 1"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <!-- Total Price -->
                    <TextView
                        android:id="@+id/tvOrderTotal1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Total: PHP 89,990.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="end">

                        <Button
                            android:id="@+id/btnViewDetails1"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="View Details"
                            android:textSize="12sp"
                            android:backgroundTint="#403939"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Order 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/orderCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvOrderId2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order #12344"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderStatus2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shipped"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:background="@android:color/holo_blue_dark"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderDate2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="February 8, 2026"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/tvOrderProduct2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Samsung Galaxy Watch 6"
                        android:textSize="14sp"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvOrderQuantity2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Quantity: 2"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/tvOrderTotal2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Total: PHP 37,980.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="end">

                        <Button
                            android:id="@+id/btnTrackOrder2"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Track Order"
                            android:textSize="12sp"
                            android:backgroundTint="#FF9800"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnViewDetails2"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="View Details"
                            android:textSize="12sp"
                            android:backgroundTint="#403939"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Order 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/orderCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvOrderId3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Order #12343"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOrderStatus3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pending"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:background="@android:color/holo_orange_dark"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvOrderDate3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="February 10, 2026"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E0E0E0" />

                    <TextView
                        android:id="@+id/tvOrderProduct3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nike Air Max 2024"
                        android:textSize="14sp"
                        android:textColor="#212121" />

                    <TextView
                        android:id="@+id/tvOrderQuantity3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Quantity: 1"
                        android:textSize="12sp"
                        android:textColor="#757575" />

                    <TextView
                        android:id="@+id/tvOrderTotal3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Total: PHP 7,495.00"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#2E7D32" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp"
                        android:gravity="end">

                        <Button
                            android:id="@+id/btnCancelOrder3"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Cancel"
                            android:textSize="12sp"
                            android:backgroundTint="#F44336"
                            android:textColor="@android:color/white"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnViewDetails3"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="View Details"
                            android:textSize="12sp"
                            android:backgroundTint="#403939"
                            android:textColor="@android:color/white" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>